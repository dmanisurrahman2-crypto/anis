nd:#fff;border:1px solid #E5E7EB;border-radius:14px;padding:20px;transition:all .25s ease;opacity:0;animation:zsFadeUp .6s ease-out forwards}\n  .zs-dcard:hover{transform:translateY(-3px);border-color:#E8871E}\n  .zs-dcard:nth-child(1){animation-delay:.22s}\n  .zs-dcard:nth-child(2){animation-delay:.30s}\n  .zs-dcard:nth-child(3){animation-delay:.38s}\n  .zs-dcard:nth-child(4){animation-delay:.46s}\n  .zs-dcard:nth-child(5){animation-delay:.54s}\n  .zs-dcard:nth-child(6){animation-delay:.62s}\n  .zs-dcard h3{font-size:17px;font-weight:800;margin:0 0 6px 0;color:#1F2937}\n  .zs-dcard p{font-size:15px;line-height:1.6;color:#4B5563;margin:0}\n  @media(max-width:768px){.zs-cards{grid-template-columns:1fr}.zs-deliver h2{font-size:30px}}\n  @media(max-width:480px){.zs-deliver h2{font-size:26px}.zs-deliver{padding:52px 16px}}\n  @media(max-width:360px){.zs-deliver h2{font-size:22px}.zs-deliver{padding:44px 14px}}\n\n  .zs-faq{background:#F9FAFB;padding:86px 24px}\n  .zs-faq .head{max-width:820px;margin:0 auto 46px auto;text-align:center;opacity:0;animation:zsFadeUp .6s ease-out forwards;animation-delay:.08s}\n  .zs-faq h2{font-size:40px;font-weight:800;line-height:1.2;letter-spacing:-0.02em;margin:0;color:#1F2937}\n  .zs-faq .head p{font-size:18px;line-height:1.6;color:#4B5563;margin:16px 0 0 0}\n  .zs-faq-list{max-width:820px;margin:0 auto;display:flex;flex-direction:column;gap:14px}\n  .zs-faq-item{background:#fff;border:1px solid #E5E7EB;border-radius:14px;opacity:0;animation:zsFadeUp .6s ease-out forwards}\n  .zs-faq-item:nth-child(1){animation-delay:.24s}\n  .zs-faq-item:nth-child(2){animation-delay:.32s}\n  .zs-faq-item:nth-child(3){animation-delay:.40s}\n  .zs-faq-item:nth-child(4){animation-delay:.48s}\n  .zs-faq-item:nth-child(5){animation-delay:.56s}\n  .zs-q{display:flex;justify-content:space-between;align-items:flex-start;width:100%;text-align:left;padding:20px 20px;font-size:17px;font-weight:700;color:#1F2937;background:transparent;border:none;cursor:pointer;border-radius:14px}\n  .zs-q:hover{background:#F9FAFB}\n  .zs-q span{flex:1;margin-right:14px;line-height:1.4}\n  .zs-q i{font-size:15px;color:#E8871E;transition:transform .3s ease;flex-shrink:0;padding-top:4px}\n  .zs-a{max-height:0;overflow:hidden;padding:0 20px;transition:max-height .4s ease,padding .4s ease}\n  .zs-a p{margin:0 0 18px 0;font-size:15.5px;line-height:1.65;color:#4B5563}\n  .zs-faq-item.active .zs-a{max-height:320px;padding:0 20px}\n  .zs-faq-item.active .zs-q{color:#E8871E}\n  .zs-faq-item.active .zs-q i{transform:rotate(180deg)}\n  .zs-a a{color:#E8871E;font-weight:700;text-decoration:none}\n  .zs-a a:hover{text-decoration:underline}\n  @media(max-width:480px){.zs-faq h2{font-size:26px}.zs-faq{padding:52px 16px}}\n  @media(max-width:360px){.zs-faq h2{font-size:22px}.zs-faq{padding:44px 14px}}\n</style>\n\n<div class=\"zs-hero-container\">\n  <div class=\"zs-hero-wrapper\">\n    <div class=\"zs-hero-content\">\n      <span class=\"zs-badge\">☀️ Zonwering specialist</span>\n      <h1 class=\"zs-h1\">Zonneschermen op maat</h1>\n      <p class=\"zs-lead\">Zoek je een zonnescherm dat precies bij je terras en je gevel past? SLS Zonwering maakt knikarmschermen, uitvalschermen en markiezen op maat, met een stevig aluminium frame en een doek dat tegen een stootje kan. Jij kiest de kleur, de bediening en de afmeting — wij zorgen dat het zonnescherm goed staat en lang meegaat.</p>\n      <div class=\"zs-btns\">\n        <a class=\"zs-btn zs-primary\" href=\"mailto:info@slszonwering.nl\">Vraag gratis advies aan →</a>\n      </div>\n      <div class=\"zs-chips\">\n        <span class=\"zs-chip\"><i class=\"fa-solid fa-ruler-combined\"></i>Op maat gemaakt</span>\n        <span class=\"zs-chip\"><i class=\"fa-solid fa-sun\"></i>UV-werend doek</span>\n        <span class=\"zs-chip\"><i class=\"fa-solid fa-screwdriver-wrench\"></i>Eigen montageteam</span>\n      </div>\n    </div>\n    <div class=\"zs-imgwrap\">\n      <!-- IMAGE 1 (hero) — TODO: replace src with a real SLS Zonwering media-library URL once the sls-zonwering MCP server connects. Pick a photo of an installed knikarmscherm or uitvalscherm on a terrace/gevel. -->\n      <img src=\"{TODO: real hero image URL from WordPress media library}\" alt=\"Knikarmscherm zonnescherm op maat gemonteerd op een terras\" onerror=\"this.style.display='none'\">\n    </div>\n  </div>\n</div>\n\n<div class=\"zs-overview\" id=\"zonneschermtypes\">\n  <div class=\"head\">\n    <h2>Drie soorten zonneschermen op maat</h2>\n    <p>Elk terras en elke gevel is anders. Daarom maken we knikarmschermen, uitvalschermen en markiezen allemaal op maat.</p>\n  </div>\n  <div class=\"zs-overview-body\">\n    <div class=\"zs-cards3\">\n      <div class=\"zs-card\">\n        <div class=\"zs-icobox\"><i class=\"fa-solid fa-umbrella-beach\"></i></div>\n        <div><h3>Knikarmscherm</h3><p>Een knikarmscherm monteer je tegen de gevel. Zodra je het scherm uitrolt, klappen de armen naar buiten, zodat je een ruim en schaduwrijk terras krijgt zonder steunpoten in de weg.</p></div>\n      </div>\n      <div class=\"zs-card\">\n        <div class=\"zs-icobox\"><i class=\"fa-solid fa-window-maximize\"></i></div>\n        <div><h3>Uitvalscherm</h3><p>Een uitvalscherm hangt verticaal voor je raam of gevel en werkt bij regen minstens zo goed als bij zon. Handig tegen inkijk, felle namiddagzon of opwaaiende terraskussens.</p></div>\n      </div>\n      <div class=\"zs-card\">\n        <div class=\"zs-icobox\"><i class=\"fa-solid fa-shop\"></i></div>\n        <div><h3>Markies</h3><p>De klassieke markies geeft je gevel een warme, vertrouwde uitstraling. Wij maken 'm op maat, met een acryl- of screendoek dat tegen weer en wind bestand is.</p></div>\n      </div>\n    </div>\n    <div class=\"zs-overview-img\">\n      <!-- IMAGE 2 (product overview) — TODO: replace src with a real SLS Zonwering media-library URL once the sls-zonwering MCP server connects. Pick a photo showing the doek/frame close-up or a markies. -->\n      <img src=\"{TODO: real product-overview image URL from WordPress media library}\" alt=\"Close-up van een acryldoek zonnescherm met aluminium frame\" onerror=\"this.style.display='none'\">\n    </div>\n  </div>\n</div>\n\n<div class=\"zs-how\" id=\"werkwijze\">\n  <div class=\"head\">\n    <h2>Zo werkt het</h2>\n    <p>Van eerste gesprek tot montage: dit zijn de stappen naar jouw nieuwe zonnescherm.</p>\n  </div>\n  <div class=\"zs-steps\">\n    <div class=\"zs-step\">\n      <div class=\"zs-step-ico\"><i class=\"fa-solid fa-comments\"></i></div>\n      <div class=\"zs-step-kicker\">Stap 1</div>\n      <h3>Adviesgesprek</h3>\n      <p>We bespreken samen wat je zoekt: het type scherm, de kleur en hoe je het wilt bedienen.</p>\n    </div>\n    <div class=\"zs-step\">\n      <div class=\"zs-step-ico\"><i class=\"fa-solid fa-ruler\"></i></div>\n      <div class=\"zs-step-kicker\">Stap 2</div>\n      <h3>Opmeten aan huis</h3>\n      <p>Onze monteur meet de exacte maten op locatie op, zodat het scherm precies past.</p>\n    </div>\n    <div class=\"zs-step\">\n      <div class=\"zs-step-ico\"><i class=\"fa-solid fa-industry\"></i></div>\n      <div class=\"zs-step-kicker\">Stap 3</div>\n      <h3>Maatwerk productie</h3>\n      <p>Je zonnescherm wordt op maat gemaakt, in de gekozen kleur en met het doek van jouw keuze.</p>\n    </div>\n    <div class=\"zs-step\">\n      <div class=\"zs-step-ico\"><i class=\"fa-solid fa-screwdriver-wrench\"></i></div>\n      <div class=\"zs-step-kicker\">Stap 4</div>\n      <h3>Montage</h3>\n      <p>Ons eigen montageteam plaatst het scherm vakkundig en laat direct zien hoe de bediening werkt.</p>\n    </div>\n  </div>\n</div>\n\n<div class=\"zs-deliver\" id=\"waarom-sls\">\n  <div class=\"head\">\n    <h2>Waarom kiezen voor SLS Zonwering</h2>\n    <p>Een zonnescherm koop je niet elke dag. Dit is waar je op kunt rekenen.</p>\n  </div>\n  <div class=\"zs-cards\">\n    <div class=\"zs-dcard\"><h3>Op maat gemaakt</h3><p>Elk zonnescherm wordt speciaal voor jouw gevel gemaakt, tot op de centimeter nauwkeurig.</p></div>\n    <div class=\"zs-dcard\"><h3>Stevig aluminium frame</h3><p>Het frame is van duurzaam aluminium, zodat het scherm bestand is tegen wind en weer.</p></div>\n    <div class=\"zs-dcard\"><h3>UV-werend doek naar keuze</h3><p>Kies uit acryldoek of screendoek. Beide zijn UV-werend en gemaakt voor buitengebruik.</p></div>\n    <div class=\"zs-dcard\"><h3>Handmatig of elektrisch</h3><p>Bedien je scherm met een handzwengel, of kies voor een elektrische motor met afstandsbediening.</p></div>\n    <div class=\"zs-dcard\"><h3>Gratis inmeten aan huis</h3><p>Onze monteur komt vrijblijvend bij je langs om de juiste maten op te nemen.</p></div>\n    <div class=\"zs-dcard\"><h3>Eigen montageteam</h3><p>Geen onderaannemers: ons eigen team plaatst en test elk zonnescherm persoonlijk.</p></div>\n  </div>\n</div>\n\n<div class=\"zs-faq\" id=\"faq\">\n  <div class=\"head\">\n    <h2>Veelgestelde vragen over zonneschermen</h2>\n    <p>Nog twijfels? Hier vind je antwoord op de meest gestelde vragen.</p>\n  </div>\n  <div class=\"zs-faq-list\">\n    <div class=\"zs-faq-item\">\n      <button class=\"zs-q\"><span>Wat kost een zonnescherm op maat?</span><i class=\"fa-solid fa-chevron-down\"></i></button>\n      <div class=\"zs-a\"><p>De prijs van een zonnescherm hangt af van de breedte, het type (knikarm, uitval of markies) en het doek dat je kiest. Vraag een gratis offerte aan, dan rekenen we het voor je uit.</p></div>\n    </div>\n    <div class=\"zs-faq-item\">\n      <button class=\"zs-q\"><span>Wat is het verschil tussen een knikarmscherm en een uitvalscherm?</span><i class=\"fa-solid fa-chevron-down\"></i></button>\n      <div class=\"zs-a\"><p>Een knikarmscherm klapt naar buiten en geeft schaduw op je terras. Een uitvalscherm hangt verticaal voor het raam en werkt ook goed tegen inkijk of opwaaiende wind.</p></div>\n    </div>\n    <div class=\"zs-faq-item\">\n      <button class=\"zs-q\"><span>Welk doek kies ik: acryl of screen?</span><i class=\"fa-solid fa-chevron-down\"></i></button>\n      <div class=\"zs-a\"><p>Acryldoek voelt zachter aan en is er in veel kleuren. Screendoek is strakker geweven, laat wat licht door en blijft ook bij wind rustiger hangen. Twijfel je? Wij adviseren je graag welk doek bij jouw situatie past.</p></div>\n    </div>\n    <div class=\"zs-faq-item\">\n      <button class=\"zs-q\"><span>Kan ik mijn zonnescherm elektrisch laten bedienen?</span><i class=\"fa-solid fa-chevron-down\"></i></button>\n      <div class=\"zs-a\"><p>Ja, elk zonnescherm is ook leverbaar met een elektrische motor en afstandsbediening. Bekijk onze pagina over <a href=\"https://www.slszonwering.nl/elektrische-zonwering/\">elektrische zonwering</a> voor alle mogelijkheden.</p></div>\n    </div>\n    <div class=\"zs-faq-item\">\n      <button class=\"zs-q\"><span>Hoe lang duurt het plaatsen van een zonnescherm?</span><i class=\"fa-solid fa-chevron-down\"></i></button>\n      <div class=\"zs-a\"><p>Na het inmeten wordt je zonnescherm op maat gemaakt. De montage zelf is meestal in één dagdeel klaar.</p></div>\n    </div>\n  </div>\n</div>\n\n<script>\n(function(){\n  const root=document.querySelector('.zs-faq');\n  if(!root) return;\n  const items=root.querySelectorAll('.zs-faq-item');\n  items.forEach(it=>{\n    const btn=it.querySelector('.zs-q');\n    if(!btn) return;\n    btn.addEventListener('click',()=>{it.classList.toggle('active');});\n  });\n})();\n</script>\n<script>\n(function(){\n  function initHeaderNav(){\n    var toggle = document.querySelector('.sls-mobile-toggle');\n    var nav = document.querySelector('.sls-header-nav');\n    if(!toggle || !nav) return;\n    if(toggle.dataset.bound === '1') return;\n    toggle.dataset.bound = '1';\n    toggle.addEventListener('click', function(e){e.preventDefault(); nav.classList.toggle('active');});\n    nav.querySelectorAll('a').forEach(function(a){a.addEventListener('click', function(){nav.classList.remove('active');});});\n  }\n  if(document.readyState === 'loading'){document.addEventListener('DOMContentLoaded', initHeaderNav);} else {initHeaderNav();}\n})();\n</script>\n</body>\n</html>\n",
